# ==========================================
# Frontend Configuration (Client-side)
# ==========================================
# Leave empty for same-origin relative API routing (/api/contact) e.g. on Netlify.
# Set to an absolute origin (e.g. http://localhost:5001) for decoupled API servers.
VITE_API_BASE_URL=

# ==========================================
# Server Configuration (Express / Netlify Function)
# ==========================================
PORT=5001
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5001,https://nitishh.netlify.app

# ==========================================
# Resend Email Service (Server-only — NEVER prefix with VITE_)
# ==========================================
# ==========================================
# Frontend Configuration (Client-side)
# ==========================================
# Leave empty for same-origin relative API routing (/api/contact) e.g. on Netlify.
# Set to an absolute origin (e.g. http://localhost:5001) for decoupled API servers.
VITE_API_BASE_URL=

# ==========================================
# Server Configuration (Express / Netlify Function)
# ==========================================
PORT=5001
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5001,https://nitishh.netlify.app

# ==========================================
# Resend Email Service (Server-only — NEVER prefix with VITE_)
# ==========================================
RESEND_API_KEY=re_your_api_key_here
CONTACT_FROM_EMAIL=your-sender@example.com
CONTACT_TO_EMAIL=your-inbox@example.com

# ==========================================
# Upstash Redis Rate Limiting (Server-only — Optional)
# Falls back to in-memory rate limiting when omitted in development.
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# Upstash Redis Rate Limiting (Server-only — Optional)
# Falls back to in-memory rate limiting when omitted in development.
# ==========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=